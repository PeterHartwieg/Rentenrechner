{
  "name": "rentenrechner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "workers/qa-submit",
    "workers/simulate"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-og-images.mjs",
    "build": "tsc -b && vite build && npm run prerender",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:properties": "vitest run src/engine/portfolioAllowance.property.test.ts src/engine/portfolioFunding.property.test.ts src/engine/portfolioTransfer.property.test.ts src/engine/portfolioCombine.property.test.ts",
    "properties:config": "vite-node scripts/property-run-config.ts",
    "preview": "npm run build && wrangler dev",
    "worker:typecheck": "npm --prefix workers/qa-submit run typecheck && npm --prefix workers/simulate run typecheck",
    "worker:test": "npm --prefix workers/qa-submit run test && npm --prefix workers/simulate run test",
    "verify": "npm run lint && npm test && npm run worker:typecheck && npm run worker:test && npm run build",
    "repo:stats": "node scripts/repo-stats.mjs",
    "review:plan": "node scripts/review/review-plan.mjs",
    "review:run": "node scripts/review/review-run.mjs",
    "review:publish": "node scripts/review/review-publish.mjs",
    "review:sources": "vite-node scripts/review/review-sources.ts",
    "prerender": "node scripts/prerender.mjs",
    "og:generate": "node scripts/generate-og-images.mjs",
    "deploy": "npm run build && wrangler deploy",
    "check:bav": "vite-node scripts/check_bav.ts",
    "scenario:inputs": "vite-node scripts/scenario-capture-inputs.ts",
    "scenario:report": "vite-node scripts/scenario-report.ts",
    "scenario:update": "vite-node scripts/scenario-update-baseline.ts",
    "scenario:capture": "vite-node scripts/scenario-capture-inputs.ts && vite-node scripts/scenario-update-baseline.ts",
    "copy:inventory": "vite-node scripts/copy-inventory.ts",
    "copy:missing": "vite-node scripts/copy-missing.ts",
    "copy:scan": "vite-node scripts/copy-scan.ts",
    "copy:editor": "vite --open /__copy-editor/",
    "mutation:pilot": "stryker run ./stryker.pilot.json"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.9.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^2.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.0"
  }
}
